import { test, expect } from '@playwright/test';

test.describe('Voting Power Display & Rendering', () => {

  const mockDelegates = {
    data: {
      delegates: [
        {
          accountId: "whale.near",
          votingPower: "15000000000000000000000000", // 15,000 NEAR
          delegators: 10
        },
        {
          accountId: "dust.near",
          votingPower: "0",
          delegators: 0
        },
        {
          accountId: "null-power.near",
          votingPower: null,
          delegators: 2
        }
      ]
    }
  };

  test.beforeEach(async ({ page }) => {
    // Intercept GraphQL queries and mock the delegates response
    await page.route('**/graphql', async (route) => {
      const request = route.request();
      const postData = request.postData();
      
      if (postData && postData.includes('delegates')) {
        await route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(mockDelegates)
        });
      } else {
        await route.continue();
      }
    });
  });

  test('should safely render Voting Power for whales, zero balances, and null edge cases in the Delegate Table', async ({ page }) => {
    await page.goto('/delegates', { waitUntil: 'domcontentloaded' });

    // Verify the page loads
    await expect(page.locator('body')).toContainText(/Delegates/i, { timeout: 30000 });

    // Verify Whale rendering (15,000 NEAR equivalent from yoctoNEAR)
    const whaleRow = page.locator('tr').filter({ hasText: 'whale.near' });
    // The wait allows Next.js to finish hydrating the graphql mock data
    await expect(whaleRow).toBeVisible({ timeout: 30000 });
    await expect(whaleRow.locator('td').filter({ hasText: '15k' })).toBeVisible();

    // Verify Zero balance rendering
    const dustRow = page.locator('tr').filter({ hasText: 'dust.near' });
    await expect(dustRow.locator('td').filter({ hasText: '0' })).toBeVisible();

    // Verify Null balance handling (Should fallback to 0 instead of NaN or crashing)
    const nullRow = page.locator('tr').filter({ hasText: 'null-power.near' });
    await expect(nullRow.locator('td').filter({ hasText: '0' })).toBeVisible();
  });

  test('should display generic or fallback 0 voting power when no wallet is connected on the Asset Page', async ({ page }) => {
    await page.goto('/earn', { waitUntil: 'domcontentloaded' });
    
    // Wait for the asset page to settle
    await expect(page.locator('body')).toContainText(/Earn/i, { timeout: 30000 });

    // Ensure the Voting Power card doesn't crash and asks for connection/shows 0
    const vpCard = page.locator('text="Voting Power veNEAR"').locator('..');
    
    // Wait for it to become visible
    await expect(vpCard).toBeVisible({ timeout: 30000 });
    
    // The component should gracefully fall back to '0.00' or prompt to 'Connect Wallet'
    await expect(page.locator('text=/0\\.00|Connect Wallet/i').first()).toBeVisible();
  });
});
